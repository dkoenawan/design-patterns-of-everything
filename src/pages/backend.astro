---
import BaseLayout from '../layouts/BaseLayout.astro';
import AtlasBackdrop from '../components/AtlasBackdrop';
import Cartouche from '../components/Cartouche.astro';
import DomainMiniMap from '../components/DomainMiniMap';
import CQRSFlowViz from '../components/CQRSFlowViz';
import DependencyInjectionViz from '../components/DependencyInjectionViz';
import StrategyPatternViz from '../components/StrategyPatternViz';
import EventDrivenViz from '../components/EventDrivenViz';
import PatternCard from '../components/PatternCard.astro';
import SkillTree from '../components/SkillTree';
import { domains, patterns } from '../lib/atlas-data';

const base = import.meta.env.BASE_URL;

const domain = domains.find((d) => d.id === 'backend')!;
const domainPatterns = patterns.filter((p) => p.domain === 'backend');
---

<BaseLayout
  title="Backend Architecture"
  description="Clean architecture, CQRS, hexagonal patterns, and API design principles for maintainable server-side systems."
>
  <AtlasBackdrop client:only="react" />

  <main class="domain-page">

    <!-- ── Two-column hero ──────────────────────────────────────── -->
    <section class="hero-row">
      <div class="hero-text">
        <div class="breadcrumb">
          <a href={base}>Atlas</a>
          <span aria-hidden="true"> › </span>
          <span>Backend</span>
        </div>

        <Cartouche label="Domain chart · ii">
          <h1 class="domain-title">{domain.name}</h1>
          <p class="domain-subtitle">{domain.subtitle}</p>
          <p class="domain-blurb">{domain.blurb}</p>

          <div class="domain-meta">
            <div class="meta-item">
              <span class="meta-num">{domainPatterns.length}</span>
              <span class="meta-label">Entries</span>
            </div>
            <div class="meta-divider" aria-hidden="true"></div>
            <div class="meta-item">
              <span class="meta-num">{domainPatterns.filter(p => p.type === 'principle').length}</span>
              <span class="meta-label">Principles</span>
            </div>
            <div class="meta-divider" aria-hidden="true"></div>
            <div class="meta-item">
              <span class="meta-num">{domainPatterns.filter(p => p.type === 'anti').length}</span>
              <span class="meta-label">Anti-patterns</span>
            </div>
          </div>
        </Cartouche>
      </div>

      <!-- Mini-map column -->
      <div class="hero-map">
        <Cartouche label="Celestial position">
          <div class="minimap-container">
            <DomainMiniMap domain="backend" client:load />
          </div>
        </Cartouche>
      </div>
    </section>

    <!-- ── Featured visualisation — hexagonal architecture ────────── -->
    <section class="viz-row">
      <Cartouche label="Featured visualisation — ports &amp; adapters">
        <div class="viz-header">
          <h2 class="viz-title">Hexagonal Boundary</h2>
          <p class="viz-caption">
            Domain logic sits at the centre, insulated from the outside world.
            Ports define the contracts; adapters satisfy them. Infrastructure
            depends inward — the core depends on nothing.
          </p>
        </div>
        <div class="viz-canvas">
          <svg
            class="hex-diagram"
            viewBox="0 0 640 400"
            xmlns="http://www.w3.org/2000/svg"
            role="img"
            aria-label="Hexagonal architecture diagram showing Domain Core surrounded by Ports and Adapters"
          >
            <defs>
              <marker id="arrow-in" markerWidth="8" markerHeight="8" refX="6" refY="3" orient="auto">
                <path d="M0,0 L0,6 L8,3 z" fill="#d4b15e" opacity="0.6" />
              </marker>
              <marker id="arrow-out" markerWidth="8" markerHeight="8" refX="2" refY="3" orient="auto">
                <path d="M8,0 L8,6 L0,3 z" fill="#7aa3d4" opacity="0.6" />
              </marker>
            </defs>

            <!-- ── Outer hex: Adapters layer ── -->
            <!-- Regular hexagon: flat-top, cx=320 cy=200 r=172 -->
            <polygon
              points="320,28 469,114 469,286 320,372 171,286 171,114"
              fill="rgba(14,20,42,0.6)"
              stroke="rgba(122,163,212,0.35)"
              stroke-width="0.5"
            />
            <!-- Label: Adapters -->
            <text x="320" y="390" text-anchor="middle" class="layer-label" fill="#7aa3d4">Adapters</text>

            <!-- ── Middle hex: Ports layer ── -->
            <!-- r=112 -->
            <polygon
              points="320,88 417,144 417,256 320,312 223,256 223,144"
              fill="rgba(10,14,26,0.85)"
              stroke="rgba(212,177,94,0.45)"
              stroke-width="0.5"
            />
            <!-- Label: Ports -->
            <text x="428" y="200" text-anchor="start" class="layer-label" fill="#d4b15e">Ports</text>

            <!-- ── Inner hex: Domain Core ── -->
            <!-- r=60 -->
            <polygon
              points="320,140 372,170 372,230 320,260 268,230 268,170"
              fill="rgba(212,177,94,0.08)"
              stroke="rgba(212,177,94,0.7)"
              stroke-width="1"
            />
            <!-- Core label -->
            <text x="320" y="194" text-anchor="middle" class="core-label" fill="#d4b15e">Domain</text>
            <text x="320" y="214" text-anchor="middle" class="core-label" fill="#d4b15e">Core</text>

            <!-- ── Dependency arrows (inward — adapters → ports → core) ── -->
            <!-- Left side: DB adapter → port → core -->
            <line x1="197" y1="200" x2="243" y2="200" stroke="#d4b15e" stroke-width="0.8" opacity="0.5" marker-end="url(#arrow-in)" />
            <!-- Right side: REST adapter → port → core -->
            <line x1="443" y1="200" x2="397" y2="200" stroke="#d4b15e" stroke-width="0.8" opacity="0.5" marker-end="url(#arrow-in)" />
            <!-- Top-left: Queue adapter -->
            <line x1="210" y1="140" x2="248" y2="162" stroke="#d4b15e" stroke-width="0.8" opacity="0.5" marker-end="url(#arrow-in)" />
            <!-- Bottom-right: Email adapter -->
            <line x1="430" y1="260" x2="392" y2="238" stroke="#d4b15e" stroke-width="0.8" opacity="0.5" marker-end="url(#arrow-in)" />

            <!-- ── Adapter labels ── -->
            <!-- Left -->
            <rect x="134" y="177" width="52" height="22" rx="1" fill="rgba(10,14,26,0.9)" stroke="rgba(122,163,212,0.3)" stroke-width="0.5" />
            <text x="160" y="192" text-anchor="middle" class="adapter-label" fill="#7aa3d4">DB</text>

            <!-- Right -->
            <rect x="454" y="177" width="54" height="22" rx="1" fill="rgba(10,14,26,0.9)" stroke="rgba(122,163,212,0.3)" stroke-width="0.5" />
            <text x="481" y="192" text-anchor="middle" class="adapter-label" fill="#7aa3d4">REST</text>

            <!-- Top-left -->
            <rect x="145" y="117" width="56" height="22" rx="1" fill="rgba(10,14,26,0.9)" stroke="rgba(122,163,212,0.3)" stroke-width="0.5" />
            <text x="173" y="132" text-anchor="middle" class="adapter-label" fill="#7aa3d4">Queue</text>

            <!-- Bottom-right -->
            <rect x="436" y="252" width="56" height="22" rx="1" fill="rgba(10,14,26,0.9)" stroke="rgba(122,163,212,0.3)" stroke-width="0.5" />
            <text x="464" y="267" text-anchor="middle" class="adapter-label" fill="#7aa3d4">Email</text>

            <!-- Top-right: CLI adapter -->
            <line x1="430" y1="140" x2="392" y2="162" stroke="#d4b15e" stroke-width="0.8" opacity="0.5" marker-end="url(#arrow-in)" />
            <rect x="436" y="117" width="42" height="22" rx="1" fill="rgba(10,14,26,0.9)" stroke="rgba(122,163,212,0.3)" stroke-width="0.5" />
            <text x="457" y="132" text-anchor="middle" class="adapter-label" fill="#7aa3d4">CLI</text>

            <!-- Bottom-left: Cache adapter -->
            <line x1="210" y1="260" x2="248" y2="238" stroke="#d4b15e" stroke-width="0.8" opacity="0.5" marker-end="url(#arrow-in)" />
            <rect x="134" y="252" width="56" height="22" rx="1" fill="rgba(10,14,26,0.9)" stroke="rgba(122,163,212,0.3)" stroke-width="0.5" />
            <text x="162" y="267" text-anchor="middle" class="adapter-label" fill="#7aa3d4">Cache</text>

            <!-- ── Port labels (at hex edges) ── -->
            <text x="234" y="197" text-anchor="middle" class="port-label" fill="#d4b15e" opacity="0.8">port</text>
            <text x="406" y="197" text-anchor="middle" class="port-label" fill="#d4b15e" opacity="0.8">port</text>
            <text x="258" y="157" text-anchor="middle" class="port-label" fill="#d4b15e" opacity="0.8">port</text>
            <text x="381" y="243" text-anchor="middle" class="port-label" fill="#d4b15e" opacity="0.8">port</text>
            <text x="381" y="157" text-anchor="middle" class="port-label" fill="#d4b15e" opacity="0.8">port</text>
            <text x="258" y="243" text-anchor="middle" class="port-label" fill="#d4b15e" opacity="0.8">port</text>

            <!-- ── Plate reference ── -->
            <text x="320" y="18" text-anchor="middle" class="plate-ref" fill="#e8dcb8" opacity="0.25">Plate ii · Hexagonal Architecture · Backend Domain</text>
          </svg>
        </div>
        <div class="viz-legend">
          {[
            { color: '#d4b15e', label: 'domain core — business logic & entities' },
            { color: 'rgba(212,177,94,0.5)', label: 'ports — technology-agnostic contracts' },
            { color: '#7aa3d4', label: 'adapters — infrastructure implementations' },
          ].map(({ color, label }) => (
            <div class="legend-item">
              <span class="legend-dot" style={`background:${color}`}></span>
              <span class="legend-text">{label}</span>
            </div>
          ))}
        </div>
      </Cartouche>
    </section>

    <!-- ── CQRS flow visualisation ───────────────────────────── -->
    <section class="viz-row">
      <Cartouche label="Featured visualisation — cqrs command &amp; query separation">
        <div class="viz-header">
          <h2 class="viz-title">Command / Query Split</h2>
          <p class="viz-caption">
            Commands mutate state through a handler into the write store, then
            a projection syncs a denormalized read model. Queries bypass the
            domain model entirely — reading directly from the read store.
            Each path is optimized independently.
          </p>
        </div>
        <div class="viz-canvas">
          <CQRSFlowViz client:load />
        </div>
        <div class="viz-legend">
          {[
            { color: '#d49a7a', label: 'command path — write & mutate' },
            { color: '#7aa3d4', label: 'query path — read & project' },
            { color: 'rgba(212,177,94,0.55)', label: 'projection sync — write→read propagation' },
          ].map(({ color, label }) => (
            <div class="legend-item">
              <span class="legend-dot" style={`background:${color}`}></span>
              <span class="legend-text">{label}</span>
            </div>
          ))}
        </div>
      </Cartouche>
    </section>

    <!-- ── Dependency injection viz ──────────────────────────── -->
    <section class="viz-row">
      <Cartouche label="Featured visualisation — dependency injection &amp; ioc container">
        <div class="viz-header">
          <h2 class="viz-title">IoC Container Resolution</h2>
          <p class="viz-caption">
            The IoC container holds the wiring graph. At construction time it
            resolves each dependency, injects it into the service, and confirms
            the handshake. Services declare what they need — the container
            decides how to satisfy it, decoupling callers from implementations.
          </p>
        </div>
        <div class="viz-canvas">
          <DependencyInjectionViz client:load />
        </div>
        <div class="viz-legend">
          {[
            { color: '#d49a7a', label: 'container → service · resolution token' },
            { color: '#7aa3d4', label: 'service → dependency · injection call' },
            { color: '#d4b15e', label: 'ring pulse · wiring confirmed' },
          ].map(({ color, label }) => (
            <div class="legend-item">
              <span class="legend-dot" style={`background:${color}`}></span>
              <span class="legend-text">{label}</span>
            </div>
          ))}
        </div>
      </Cartouche>
    </section>

    <!-- ── Strategy pattern viz ─────────────────────────────── -->
    <section class="viz-row">
      <Cartouche label="Featured visualisation — strategy pattern &amp; runtime delegation">
        <div class="viz-header">
          <h2 class="viz-title">Runtime Strategy Selection</h2>
          <p class="viz-caption">
            OrderService invokes Checkout with a request. The context delegates
            to whichever ShippingStrategy is currently injected — Standard,
            Express, Overnight, or Economy — then returns the result. The
            strategy rotates every few seconds, showing how behaviour changes
            without modifying the calling code.
          </p>
        </div>
        <div class="viz-canvas">
          <StrategyPatternViz client:load />
        </div>
        <div class="viz-legend">
          {[
            { color: '#d4b15e', label: 'request token — client → context' },
            { color: '#7aa3d4', label: 'standard / economy strategy active' },
            { color: '#d49a7a', label: 'express strategy active' },
            { color: '#c8a4d4', label: 'overnight strategy active' },
          ].map(({ color, label }) => (
            <div class="legend-item">
              <span class="legend-dot" style={`background:${color}`}></span>
              <span class="legend-text">{label}</span>
            </div>
          ))}
        </div>
      </Cartouche>
    </section>

    <!-- ── Event-driven architecture viz ───────────────────────── -->
    <section class="viz-row">
      <Cartouche label="Featured visualisation — event-driven architecture &amp; pub/sub topology">
        <div class="viz-header">
          <h2 class="viz-title">Event Bus Topology</h2>
          <p class="viz-caption">
            Producers emit domain events onto a shared bus; subscribers receive
            only the events they declare interest in. OrderSvc, InventorySvc, and
            PaymentSvc publish independently — the bus routes to AuditSvc (all),
            WarehouseSvc (orders + stock), NotifySvc (orders), and BillingSvc (payments).
            No producer knows its consumers.
          </p>
        </div>
        <div class="viz-canvas">
          <EventDrivenViz client:load />
        </div>
        <div class="viz-legend">
          {[
            { color: '#d49a7a', label: 'order.placed · OrderSvc → NotifySvc, WarehouseSvc, AuditSvc' },
            { color: '#9ec48a', label: 'stock.updated · InventorySvc → WarehouseSvc, AuditSvc' },
            { color: '#c8a4d4', label: 'payment.done · PaymentSvc → BillingSvc, AuditSvc' },
            { color: '#d4b15e', label: 'event bus · pub/sub routing layer' },
          ].map(({ color, label }) => (
            <div class="legend-item">
              <span class="legend-dot" style={`background:${color}`}></span>
              <span class="legend-text">{label}</span>
            </div>
          ))}
        </div>
      </Cartouche>
    </section>

    <!-- ── Skill tree ─────────────────────────────────────────── -->
    <section class="skill-tree-row">
      <Cartouche label="Skill progression — Backend Architecture">
        <div class="skill-tree-header">
          <h2 class="skill-tree-title">Architecture Proficiency</h2>
          <p class="skill-tree-caption">
            Foundational principles compose into advanced patterns. Select any
            node to inspect the skill and its role in the broader architecture.
          </p>
        </div>
        <div class="skill-tree-container">
          <SkillTree domain="backend" client:load />
        </div>
      </Cartouche>
    </section>

    <!-- ── Pattern catalogue ───────────────────────────────────── -->
    <section class="catalogue-row">
      <Cartouche label="Pattern catalogue — Backend">
        {domainPatterns.map((p, i) => (
          <PatternCard
            id={p.id}
            name={p.name}
            domain={p.domain}
            type={p.type}
            complexity={p.complexity}
            note={p.note}
            href={p.href}
            index={i}
          />
        ))}
      </Cartouche>
    </section>

    <!-- ── Footer row ──────────────────────────────────────────── -->
    <section class="footer-row">
      <div class="footer-nav">
        <a href={`${base}/frontend`} class="nav-link">← Frontend</a>
        <a href={`${base}/data`} class="nav-link">Data Pipeline →</a>
      </div>
      <p class="footer-coord">Plate ii — Backend · RA +780° Dec −420°</p>
    </section>

  </main>
</BaseLayout>

<style>
  .domain-page {
    position: relative;
    z-index: 1;
    max-width: 1080px;
    margin: 0 auto;
    padding: 80px 32px 120px;
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  /* Breadcrumb */
  .breadcrumb {
    font-family: var(--font-mono);
    font-style: normal;
    font-size: 10px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--ink-dim);
    margin-bottom: 24px;
  }

  .breadcrumb a {
    color: var(--ink-dim);
    text-decoration: none;
  }

  .breadcrumb a:hover {
    color: var(--gold);
  }

  /* ── Hero row ── */
  .hero-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
    align-items: start;
  }

  @media (max-width: 768px) {
    .hero-row {
      grid-template-columns: 1fr;
    }
  }

  .domain-title {
    font-size: 56px;
    color: var(--tint-backend);
    line-height: 1;
    margin-bottom: 8px;
  }

  .domain-subtitle {
    font-size: 18px;
    color: var(--ink-dim);
    margin-bottom: 20px;
    font-style: italic;
  }

  .domain-blurb {
    font-size: 17px;
    color: var(--ink);
    line-height: 1.55;
    margin-bottom: 28px;
  }

  .domain-meta {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .meta-item {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2px;
  }

  .meta-num {
    font-size: 32px;
    font-style: italic;
    color: var(--tint-backend);
    line-height: 1;
  }

  .meta-label {
    font-family: var(--font-mono);
    font-style: normal;
    font-size: 9px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .meta-divider {
    width: 0.5px;
    height: 32px;
    background: var(--paper-border);
  }

  .minimap-container {
    width: 100%;
    height: 280px;
  }

  /* ── Visualisation row ── */
  .viz-header {
    margin-bottom: 28px;
  }

  .viz-title {
    font-size: 28px;
    color: var(--ink);
    margin-bottom: 10px;
  }

  .viz-caption {
    font-size: 15px;
    color: var(--ink-dim);
    line-height: 1.55;
    max-width: 560px;
  }

  .viz-canvas {
    width: 100%;
  }

  /* ── Hexagonal diagram ── */
  .hex-diagram {
    width: 100%;
    max-width: 640px;
    display: block;
    margin: 0 auto;
  }

  .hex-diagram .layer-label {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .hex-diagram .core-label {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 13px;
  }

  .hex-diagram .adapter-label {
    font-family: var(--font-mono);
    font-size: 8px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
  }

  .hex-diagram .port-label {
    font-family: var(--font-mono);
    font-size: 7px;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .hex-diagram .plate-ref {
    font-family: var(--font-mono);
    font-size: 7px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
  }

  /* ── Legend ── */
  .viz-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 28px;
    margin-top: 20px;
    padding-top: 16px;
    border-top: 0.5px solid var(--line-faint);
  }

  .legend-item {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .legend-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .legend-text {
    font-family: var(--font-mono);
    font-style: normal;
    font-size: 9px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--ink-dim);
  }

  /* ── Footer row ── */
  .footer-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 32px;
    border-top: 0.5px solid var(--line-faint);
  }

  .footer-nav {
    display: flex;
    gap: 32px;
  }

  .nav-link {
    font-size: 15px;
    color: var(--gold);
    text-decoration: none;
    font-style: italic;
  }

  .nav-link:hover {
    color: var(--gold-bright);
  }

  .footer-coord {
    font-family: var(--font-mono);
    font-style: normal;
    font-size: 9px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  /* ── Skill tree row ── */
  .skill-tree-header {
    margin-bottom: 28px;
  }

  .skill-tree-title {
    font-size: 28px;
    color: var(--ink);
    margin-bottom: 10px;
  }

  .skill-tree-caption {
    font-size: 15px;
    color: var(--ink-dim);
    line-height: 1.55;
    max-width: 560px;
  }

  .skill-tree-container {
    max-width: 520px;
    margin: 0 auto;
  }

  @media (max-width: 640px) {
    .domain-page {
      padding: 60px 20px 80px;
    }

    .footer-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
    }
  }
</style>
