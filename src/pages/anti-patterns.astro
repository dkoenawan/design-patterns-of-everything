---
import BaseLayout from '../layouts/BaseLayout.astro';
import AtlasBackdrop from '../components/AtlasBackdrop';
import Cartouche from '../components/Cartouche.astro';
import BlastRadiusViz from '../components/BlastRadiusViz';
import { patterns, patternPageHref } from '../lib/atlas-data';
import { antiPatterns, antiPatternRef, severityLabel } from '../lib/anti-patterns';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const patternName = (id: string) => patterns.find((p) => p.id === id)!.name;

const severityDots = (s: number) =>
  Array.from({ length: 5 }, (_, i) => (i < s ? '◆' : '◇')).join('');

const description =
  'Common architectural anti-patterns across Backend, Data Pipeline, Infrastructure, and Frontend — what they look like, why they persist, and how to eliminate them.';

// schema.org structured data: the catalog as a CollectionPage whose ItemList is
// the hazard register below — each entry addressed by its on-page anchor — plus
// the visible Atlas › Anti-Patterns trail.
const atlasURL = new URL('/design-patterns-of-everything/', Astro.site!).href;
const pageURL = new URL('anti-patterns/', atlasURL).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': `${pageURL}#page`,
      name: 'Anti-Pattern Catalog',
      description,
      url: pageURL,
      inLanguage: 'en',
      isPartOf: { '@type': 'WebSite', name: 'Design Patterns of Everything', url: atlasURL },
      mainEntity: {
        '@type': 'ItemList',
        numberOfItems: antiPatterns.length,
        itemListElement: antiPatterns.map((ap, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          name: ap.name,
          description: ap.symptom,
          url: `${pageURL}#${ap.id}`,
        })),
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Atlas', item: atlasURL },
        { '@type': 'ListItem', position: 2, name: 'Anti-Patterns', item: pageURL },
      ],
    },
  ],
};
---

<BaseLayout
  title="Anti-Pattern Catalog — Celestial Atlas"
  description={description}
  jsonLd={jsonLd}
>
  <AtlasBackdrop client:only="react" />

  <main class="catalog-page">

    <!-- ── Page header ──────────────────────────────────────────── -->
    <section class="page-header">
      <div class="breadcrumb">
        <a href={`${base}/`}>Atlas</a>
        <span aria-hidden="true"> › </span>
        <span>Anti-Patterns</span>
      </div>

      <Cartouche label="Catalog of hazards — known failure modes">
        <div class="header-inner">
          <div class="header-glyph" aria-hidden="true">✗</div>
          <div class="header-text">
            <h1 class="page-title">Anti-Pattern Catalog</h1>
            <p class="page-subtitle">
              Patterns that feel like solutions but compound the problems they were meant to solve.
              Severity is measured by blast radius and recovery cost, not by frequency.
            </p>

            <div class="header-stats">
              <div class="stat-item">
                <span class="stat-num">{antiPatterns.length}</span>
                <span class="stat-label">Entries</span>
              </div>
              <div class="stat-divider" aria-hidden="true"></div>
              <div class="stat-item">
                <span class="stat-num">{antiPatterns.filter((a) => a.severity >= 4).length}</span>
                <span class="stat-label">High / Critical</span>
              </div>
              <div class="stat-divider" aria-hidden="true"></div>
              <div class="stat-item">
                <span class="stat-num">
                  {[...new Set(antiPatterns.map((a) => a.domain))].length}
                </span>
                <span class="stat-label">Domains</span>
              </div>
            </div>
          </div>
        </div>
      </Cartouche>
    </section>

    <!-- ── Blast radius visualisation ──────────────────────────── -->
    <section class="radar-row">
      <Cartouche label="Hazard field — severity by proximity">
        <div class="viz-header">
          <h2 class="viz-title">Blast Radius</h2>
          <p class="viz-caption">
            Each hazard plotted by severity: the closer to the core, the greater
            the blast radius and recovery cost. A shockwave sweeps outward on a
            continuous cycle as a reminder that these failure modes propagate.
          </p>
        </div>
        <div class="viz-canvas">
          <BlastRadiusViz client:visible />
        </div>
      </Cartouche>
    </section>

    <!-- ── Anti-pattern entries ───────────────────────────────── -->
    <section class="entries-row">
      <Cartouche label="Hazard register — field observations">
        {antiPatterns.map((ap) => (
          <article class="entry" id={ap.id}>
            <!-- Rail -->
            <div class="entry-rail">
              <span class="entry-domain" style={`color: ${ap.tint}`}>
                {ap.domainLabel}
              </span>
              <span class="entry-severity" aria-label={`Severity ${severityLabel[ap.severity]}`}>
                {severityDots(ap.severity)}
              </span>
              <span class="entry-severity-label"
                    style={ap.severity >= 4 ? 'color: var(--anti)' : ''}>
                {severityLabel[ap.severity]}
              </span>
              <span class="entry-num">
                {antiPatternRef(ap)}
              </span>
            </div>

            <!-- Body -->
            <div class="entry-body">
              <h2 class="entry-name" style={`color: ${ap.tint}`}>
                <span class="entry-glyph" aria-hidden="true">✗</span>
                {ap.name}
              </h2>

              <div class="entry-section">
                <h3 class="entry-section-label">Symptom</h3>
                <p class="entry-text">{ap.symptom}</p>
              </div>

              <div class="entry-section">
                <h3 class="entry-section-label">Consequence</h3>
                <p class="entry-text">{ap.consequence}</p>
              </div>

              <div class="entry-section">
                <h3 class="entry-section-label">Mitigation</h3>
                <p class="entry-text entry-text--mitigation">{ap.mitigation}</p>
              </div>

              {ap.remedies.length > 0 && (
                <div class="entry-section">
                  <h3 class="entry-section-label">Remedial patterns</h3>
                  <ul class="remedy-list">
                    {ap.remedies.map((id) => (
                      <li>
                        <span class="remedy-bullet" aria-hidden="true">◈</span>
                        <a href={patternPageHref(id)} class="remedy-link">{patternName(id)}</a>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </div>
          </article>
        ))}
      </Cartouche>
    </section>

    <!-- ── Footer row ─────────────────────────────────────────── -->
    <section class="footer-row">
      <div class="footer-nav">
        <a href={`${base}/`} class="nav-link">← Atlas home</a>
        <a href={`${base}/patterns-catalog/`} class="nav-link">Pattern catalog →</a>
      </div>
      <p class="footer-coord">Hazard register · Supplement I</p>
    </section>

  </main>
</BaseLayout>

<style>
  .catalog-page {
    position: relative;
    z-index: 1;
    max-width: 900px;
    margin: 0 auto;
    padding: 80px 32px 120px;
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  /* ── Breadcrumb ── */
  .breadcrumb {
    font-family: var(--font-mono);
    font-style: normal;
    font-size: 10px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--ink-dim);
    margin-bottom: 24px;
  }

  .breadcrumb a {
    color: var(--ink-dim);
    text-decoration: none;
  }

  .breadcrumb a:hover {
    color: var(--gold);
  }

  /* ── Header ── */
  .header-inner {
    display: flex;
    gap: 28px;
    align-items: flex-start;
  }

  .header-glyph {
    font-size: 44px;
    color: var(--anti);
    line-height: 1;
    flex-shrink: 0;
    margin-top: 6px;
  }

  .page-title {
    font-size: 52px;
    color: var(--ink);
    line-height: 1;
    margin-bottom: 12px;
  }

  .page-subtitle {
    font-size: 17px;
    color: var(--ink-dim);
    line-height: 1.6;
    max-width: 580px;
    margin-bottom: 24px;
  }

  .header-stats {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .stat-item {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .stat-num {
    font-size: 28px;
    font-style: italic;
    color: var(--anti);
    line-height: 1;
  }

  .stat-label {
    font-family: var(--font-mono);
    font-style: normal;
    font-size: 9px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .stat-divider {
    width: 0.5px;
    height: 28px;
    background: var(--paper-border);
  }

  @media (max-width: 600px) {
    .header-inner {
      flex-direction: column;
      gap: 16px;
    }
    .header-glyph {
      font-size: 32px;
    }
    .page-title {
      font-size: 38px;
    }
  }

  /* ── Blast radius viz ── */
  .viz-header {
    margin-bottom: 20px;
  }

  .viz-title {
    font-size: 20px;
    color: var(--ink-dim);
    margin-bottom: 8px;
  }

  .viz-caption {
    font-size: 14px;
    color: var(--ink-dim);
    line-height: 1.5;
    max-width: 540px;
    opacity: 0.75;
  }

  .viz-canvas {
    width: 100%;
    background: rgba(10, 14, 26, 0.45);
    border: 0.5px solid var(--paper-border);
  }

  /* ── Entry ── */
  .entry {
    display: flex;
    gap: 0;
    border-top: 0.5px solid var(--line-faint);
    padding: 36px 0;
    /* Clear the 52px sticky SiteNav when an entry is opened by its anchor */
    scroll-margin-top: 52px;
  }

  .entry:last-child {
    border-bottom: 0.5px solid var(--line-faint);
  }

  /* Rail */
  .entry-rail {
    width: 140px;
    flex-shrink: 0;
    padding-right: 28px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .entry-domain {
    font-size: 12px;
    font-family: var(--font-display);
    font-style: italic;
  }

  .entry-severity {
    font-family: var(--font-mono);
    font-style: normal;
    font-size: 11px;
    color: var(--ink-dim);
    letter-spacing: 1.5px;
  }

  .entry-severity-label {
    font-family: var(--font-mono);
    font-style: normal;
    font-size: 9px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .entry-num {
    font-family: var(--font-mono);
    font-style: normal;
    font-size: 10px;
    letter-spacing: 1.5px;
    color: var(--ink-faint);
    margin-top: 4px;
  }

  /* Body */
  .entry-body {
    flex: 1;
    min-width: 0;
  }

  .entry-name {
    font-size: 38px;
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    line-height: 1.05;
    margin-bottom: 28px;
    display: flex;
    align-items: baseline;
    gap: 12px;
  }

  .entry-glyph {
    font-size: 20px;
    color: var(--anti);
    flex-shrink: 0;
  }

  .entry-section {
    margin-bottom: 20px;
  }

  .entry-section:last-child {
    margin-bottom: 0;
  }

  .entry-section-label {
    font-family: var(--font-mono);
    font-style: normal;
    font-size: 9px;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin-bottom: 8px;
  }

  .entry-text {
    font-size: 16px;
    font-family: var(--font-display);
    font-style: italic;
    color: var(--ink-dim);
    line-height: 1.6;
  }

  .entry-text--mitigation {
    color: var(--ink);
  }

  .remedy-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px 24px;
  }

  .remedy-bullet {
    color: var(--gold);
    font-size: 11px;
    margin-right: 8px;
  }

  .remedy-link {
    font-size: 16px;
    font-family: var(--font-display);
    font-style: italic;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 0.5px solid var(--paper-border);
    transition: color 150ms, border-color 150ms;
  }

  .remedy-link:hover {
    color: var(--gold-bright);
    border-bottom-color: var(--gold-bright);
  }

  @media (max-width: 560px) {
    .entry {
      flex-direction: column;
      gap: 20px;
    }

    .entry-rail {
      width: auto;
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      gap: 12px;
      padding-right: 0;
    }

    .entry-num {
      margin-top: 0;
    }

    .entry-name {
      font-size: 28px;
    }
  }

  /* ── Footer ── */
  .footer-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 32px;
    border-top: 0.5px solid var(--line-faint);
  }

  .footer-nav {
    display: flex;
    gap: 32px;
  }

  .nav-link {
    font-size: 15px;
    color: var(--gold);
    text-decoration: none;
    font-style: italic;
  }

  .nav-link:hover {
    color: var(--gold-bright);
  }

  .footer-coord {
    font-family: var(--font-mono);
    font-style: normal;
    font-size: 9px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  @media (max-width: 640px) {
    .catalog-page {
      padding: 60px 20px 80px;
    }

    .footer-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
    }
  }
</style>
