---
import BaseLayout from '../layouts/BaseLayout.astro';
import AtlasBackdrop from '../components/AtlasBackdrop';
import Cartouche from '../components/Cartouche.astro';
import DomainMiniMap from '../components/DomainMiniMap';
import ComponentTreeViz from '../components/ComponentTreeViz';
import PatternCatalogue from '../components/PatternCatalogue';
import { domains, patterns } from '../lib/atlas-data';

const base = import.meta.env.BASE_URL;

const domain = domains.find((d) => d.id === 'frontend')!;
const domainPatterns = patterns.filter((p) => p.domain === 'frontend');
---

<BaseLayout
  title="Frontalia — Frontend Architecture"
  description="Component patterns, state management strategies, micro-frontends, and scalable UI systems for complex frontend applications."
>
  <AtlasBackdrop client:load />

  <main class="domain-page">

    <!-- ── Two-column hero ──────────────────────────────────────── -->
    <section class="hero-row">
      <div class="hero-text">
        <div class="breadcrumb">
          <a href={base}>Atlas</a>
          <span aria-hidden="true"> › </span>
          <span>Frontalia</span>
        </div>

        <Cartouche label="Domain chart · i">
          <h1 class="domain-title">{domain.name}</h1>
          <p class="domain-subtitle">{domain.subtitle}</p>
          <p class="domain-blurb">{domain.blurb}</p>

          <div class="domain-meta">
            <div class="meta-item">
              <span class="meta-num">{domainPatterns.length}</span>
              <span class="meta-label">Entries</span>
            </div>
            <div class="meta-divider" aria-hidden="true"></div>
            <div class="meta-item">
              <span class="meta-num">{domainPatterns.filter(p => p.type === 'principle').length}</span>
              <span class="meta-label">Principles</span>
            </div>
            <div class="meta-divider" aria-hidden="true"></div>
            <div class="meta-item">
              <span class="meta-num">{domainPatterns.filter(p => p.type === 'anti').length}</span>
              <span class="meta-label">Anti-patterns</span>
            </div>
          </div>
        </Cartouche>
      </div>

      <!-- Mini-map column -->
      <div class="hero-map">
        <Cartouche label="Celestial position">
          <div class="minimap-container">
            <DomainMiniMap domain="frontend" client:load />
          </div>
        </Cartouche>
      </div>
    </section>

    <!-- ── Featured visualisation ──────────────────────────────── -->
    <section class="viz-row">
      <Cartouche label="Featured visualisation — props-flow component tree">
        <div class="viz-header">
          <h2 class="viz-title">Component Tree Architecture</h2>
          <p class="viz-caption">
            Props flow downward through the tree — Page composes Organisms,
            Organisms compose Molecules, Molecules compose Atoms.
            Each mote traces a single prop-flow branch through the hierarchy.
          </p>
        </div>
        <div class="viz-canvas">
          <ComponentTreeViz client:load />
        </div>
        <div class="viz-legend">
          {[
            { color: '#7aa3d4', label: 'header → nav → link' },
            { color: '#d49a7a', label: 'main → content → text' },
            { color: '#9ec48a', label: 'sidebar → panel → badge' },
            { color: '#c8a4d4', label: 'header → logo → icon' },
            { color: '#f1d98a', label: 'main → toolbar → button' },
          ].map(({ color, label }) => (
            <div class="legend-item">
              <span class="legend-dot" style={`background:${color}`}></span>
              <span class="legend-text">{label}</span>
            </div>
          ))}
        </div>
      </Cartouche>
    </section>

    <!-- ── Pattern catalogue ───────────────────────────────────── -->
    <section class="catalogue-row">
      <Cartouche label="Pattern catalogue — Frontalia">
        <PatternCatalogue domain="frontend" patterns={domainPatterns} client:load />
      </Cartouche>
    </section>

    <!-- ── Footer row ──────────────────────────────────────────── -->
    <section class="footer-row">
      <div class="footer-nav">
        <a href={base} class="nav-link">← Return to Atlas</a>
        <a href={`${base}backend`} class="nav-link">Backendis Major →</a>
      </div>
      <p class="footer-coord">Plate i — Frontalia · RA −780° Dec −420°</p>
    </section>

  </main>
</BaseLayout>

<style>
  .domain-page {
    position: relative;
    z-index: 1;
    max-width: 1080px;
    margin: 0 auto;
    padding: 80px 32px 120px;
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  /* Breadcrumb */
  .breadcrumb {
    font-family: var(--font-mono);
    font-style: normal;
    font-size: 10px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--ink-dim);
    margin-bottom: 24px;
  }

  .breadcrumb a {
    color: var(--ink-dim);
    text-decoration: none;
  }

  .breadcrumb a:hover {
    color: var(--gold);
  }

  /* ── Hero row ── */
  .hero-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
    align-items: start;
  }

  @media (max-width: 768px) {
    .hero-row {
      grid-template-columns: 1fr;
    }
  }

  .domain-title {
    font-size: 56px;
    color: var(--tint-frontend);
    line-height: 1;
    margin-bottom: 8px;
  }

  .domain-subtitle {
    font-size: 18px;
    color: var(--ink-dim);
    margin-bottom: 20px;
    font-style: italic;
  }

  .domain-blurb {
    font-size: 17px;
    color: var(--ink);
    line-height: 1.55;
    margin-bottom: 28px;
  }

  .domain-meta {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .meta-item {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2px;
  }

  .meta-num {
    font-size: 32px;
    font-style: italic;
    color: var(--tint-frontend);
    line-height: 1;
  }

  .meta-label {
    font-family: var(--font-mono);
    font-style: normal;
    font-size: 9px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .meta-divider {
    width: 0.5px;
    height: 32px;
    background: var(--paper-border);
  }

  .minimap-container {
    width: 100%;
    height: 280px;
  }

  /* ── Visualisation row ── */
  .viz-header {
    margin-bottom: 28px;
  }

  .viz-title {
    font-size: 28px;
    color: var(--ink);
    margin-bottom: 10px;
  }

  .viz-caption {
    font-size: 15px;
    color: var(--ink-dim);
    line-height: 1.55;
    max-width: 560px;
  }

  .viz-canvas {
    width: 100%;
    margin-bottom: 20px;
  }

  .viz-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 28px;
    padding-top: 16px;
    border-top: 0.5px solid var(--line-faint);
  }

  .legend-item {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .legend-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .legend-text {
    font-family: var(--font-mono);
    font-style: normal;
    font-size: 10px;
    letter-spacing: 1px;
    color: var(--ink-dim);
  }

  /* ── Footer row ── */
  .footer-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 32px;
    border-top: 0.5px solid var(--line-faint);
  }

  .footer-nav {
    display: flex;
    gap: 32px;
  }

  .nav-link {
    font-size: 15px;
    color: var(--gold);
    text-decoration: none;
    font-style: italic;
  }

  .nav-link:hover {
    color: var(--gold-bright);
  }

  .footer-coord {
    font-family: var(--font-mono);
    font-style: normal;
    font-size: 9px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  @media (max-width: 640px) {
    .domain-page {
      padding: 60px 20px 80px;
    }

    .footer-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
    }
  }
</style>
