---
import BaseLayout from '../layouts/BaseLayout.astro';
import AtlasBackdrop from '../components/AtlasBackdrop';
import AtlasMap from '../components/AtlasMap';
---

<BaseLayout title="Design Patterns of Everything · Celestial Atlas">
  <AtlasBackdrop client:only="react" />
  <AtlasMap client:only="react" />
</BaseLayout>

<style>
  /* No scrollable content — map occupies full viewport */
  body {
    overflow: hidden;
  }
</style>
