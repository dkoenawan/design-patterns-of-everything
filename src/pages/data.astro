---
import BaseLayout from '../layouts/BaseLayout.astro';
import AtlasBackdrop from '../components/AtlasBackdrop';
import Cartouche from '../components/Cartouche.astro';
import DomainMiniMap from '../components/DomainMiniMap';
import MedallionViz from '../components/MedallionViz';
import BatchStreamViz from '../components/BatchStreamViz';
import SchemaValidationFlowViz from '../components/SchemaValidationFlowViz';
import PureFunctionPipelineViz from '../components/PureFunctionPipelineViz';
import PatternCard from '../components/PatternCard.astro';
import SkillTree from '../components/SkillTree';
import { domains, patterns } from '../lib/atlas-data';

const base = import.meta.env.BASE_URL;

const domain = domains.find((d) => d.id === 'data')!;
const domainPatterns = patterns.filter((p) => p.domain === 'data');
---

<BaseLayout
  title="Data Pipeline Architecture"
  description="Medallion architecture, schema-driven validation, pure functional pipelines, and reliable data transformation patterns."
>
  <AtlasBackdrop client:only="react" />

  <main class="domain-page">

    <!-- ── Two-column hero ──────────────────────────────────────── -->
    <section class="hero-row">
      <div class="hero-text">
        <div class="breadcrumb">
          <a href={base}>Atlas</a>
          <span aria-hidden="true"> › </span>
          <span>Data Pipeline</span>
        </div>

        <Cartouche label="Domain chart · iii">
          <h1 class="domain-title">{domain.name}</h1>
          <p class="domain-subtitle">{domain.subtitle}</p>
          <p class="domain-blurb">{domain.blurb}</p>

          <div class="domain-meta">
            <div class="meta-item">
              <span class="meta-num">{domainPatterns.length}</span>
              <span class="meta-label">Entries</span>
            </div>
            <div class="meta-divider" aria-hidden="true"></div>
            <div class="meta-item">
              <span class="meta-num">{domainPatterns.filter(p => p.type === 'principle').length}</span>
              <span class="meta-label">Principles</span>
            </div>
            <div class="meta-divider" aria-hidden="true"></div>
            <div class="meta-item">
              <span class="meta-num">{domainPatterns.filter(p => p.type === 'anti').length}</span>
              <span class="meta-label">Anti-patterns</span>
            </div>
          </div>
        </Cartouche>
      </div>

      <!-- Mini-map column -->
      <div class="hero-map">
        <Cartouche label="Celestial position">
          <div class="minimap-container">
            <DomainMiniMap domain="data" client:load />
          </div>
        </Cartouche>
      </div>
    </section>

    <!-- ── Featured visualisation ──────────────────────────────── -->
    <section class="viz-row">
      <Cartouche label="Featured visualisation — medallion refinement flow">
        <div class="viz-header">
          <h2 class="viz-title">Bronze → Silver → Gold</h2>
          <p class="viz-caption">
            Raw records enter as Bronze, then refine through Silver into Gold.
            Each stage tightens the lane and raises quality; records failing
            validation are rejected and fade away. Quality rises left to right.
          </p>
        </div>
        <div class="viz-canvas">
          <MedallionViz client:load />
        </div>
        <div class="viz-legend">
          {[
            { color: '#c08850', label: 'bronze · raw ingest' },
            { color: '#b8c4cf', label: 'silver · validated' },
            { color: '#e8c870', label: 'gold · curated' },
            { color: '#c46a55', label: '× · rejected' },
          ].map(({ color, label }) => (
            <div class="legend-item">
              <span class="legend-dot" style={`background:${color}`}></span>
              <span class="legend-text">{label}</span>
            </div>
          ))}
        </div>
      </Cartouche>
    </section>

    <!-- ── Batch vs Streaming viz ────────────────────────────── -->
    <section class="viz-row">
      <Cartouche label="Featured visualisation — batch vs streaming processing">
        <div class="viz-header">
          <h2 class="viz-title">Batch vs Streaming</h2>
          <p class="viz-caption">
            The top lane accumulates records into a bounded buffer then flushes the entire
            window in one pass — high throughput, higher latency. The bottom lane emits
            each event to a processor the moment it arrives — low latency, continuous.
            Choose based on your tolerance for staleness vs. per-event cost.
          </p>
        </div>
        <div class="viz-canvas">
          <BatchStreamViz client:load />
        </div>
        <div class="viz-legend">
          {[
            { color: '#9ec48a', label: 'batch · windowed accumulation' },
            { color: '#d4b15e', label: 'stream · per-event flow' },
          ].map(({ color, label }) => (
            <div class="legend-item">
              <span class="legend-dot" style={`background:${color}`}></span>
              <span class="legend-text">{label}</span>
            </div>
          ))}
        </div>
      </Cartouche>
    </section>

    <!-- ── Schema Validation viz ────────────────────────────── -->
    <section class="viz-row">
      <Cartouche label="Featured visualisation — schema-driven validation flow">
        <div class="viz-header">
          <h2 class="viz-title">Schema-Driven Validation</h2>
          <p class="viz-caption">
            Each record passes through a schema validator before entering the
            curated layer. Conforming records advance to the output; non-conforming
            records are deflected and tagged with the violation — null reference,
            type mismatch, missing field. The validator is the contract boundary.
          </p>
        </div>
        <div class="viz-canvas">
          <SchemaValidationFlowViz client:load />
        </div>
        <div class="viz-legend">
          {[
            { color: '#e8dcb8', label: 'record · approaching validator' },
            { color: '#d4b15e', label: 'schema pulse · validation event' },
            { color: '#9ec48a', label: 'pass · conforms to schema' },
            { color: '#c46a55', label: 'reject · constraint violation' },
          ].map(({ color, label }) => (
            <div class="legend-item">
              <span class="legend-dot" style={`background:${color}`}></span>
              <span class="legend-text">{label}</span>
            </div>
          ))}
        </div>
      </Cartouche>
    </section>

    <!-- ── Pure function pipeline viz ─────────────────────────── -->
    <section class="viz-row">
      <Cartouche label="Featured visualisation — pure function composition pipeline">
        <div class="viz-header">
          <h2 class="viz-title">Pure Function Pipeline</h2>
          <p class="viz-caption">
            Each stage is a pure function: same input always yields the same output,
            no hidden state, no side effects. Records flow Parse → Validate →
            Normalize → Enrich → Aggregate. Non-conforming records are rejected at
            Validate and deflect to the error bin — all other stages are guaranteed safe.
          </p>
        </div>
        <div class="viz-canvas">
          <PureFunctionPipelineViz client:load />
        </div>
        <div class="viz-legend">
          {[
            { color: '#e8dcb8', label: 'raw record · pre-parse' },
            { color: '#7aa3d4', label: 'parsed · structured tokens extracted' },
            { color: '#9ec48a', label: 'validated · schema conformant' },
            { color: '#c8a4d4', label: 'normalized · canonical form' },
            { color: '#d49a7a', label: 'enriched · context appended' },
            { color: '#d4b15e', label: 'aggregated · curated output' },
            { color: '#c46a55', label: 'rejected · constraint violation' },
          ].map(({ color, label }) => (
            <div class="legend-item">
              <span class="legend-dot" style={`background:${color}`}></span>
              <span class="legend-text">{label}</span>
            </div>
          ))}
        </div>
      </Cartouche>
    </section>

    <!-- ── Skill tree ─────────────────────────────────────────── -->
    <section class="skill-tree-row">
      <Cartouche label="Skill progression — Data Pipeline Architecture">
        <div class="skill-tree-header">
          <h2 class="skill-tree-title">Pipeline Proficiency</h2>
          <p class="skill-tree-caption">
            Pure functions and schema contracts underpin every higher-order
            pattern. Select any node to see how skills build on one another.
          </p>
        </div>
        <div class="skill-tree-container">
          <SkillTree domain="data" client:load />
        </div>
      </Cartouche>
    </section>

    <!-- ── Pattern catalogue ───────────────────────────────────── -->
    <section class="catalogue-row">
      <Cartouche label="Pattern catalogue — Data Pipeline">
        {domainPatterns.map((p, i) => (
          <PatternCard
            id={p.id}
            name={p.name}
            domain={p.domain}
            type={p.type}
            complexity={p.complexity}
            note={p.note}
            href={p.href}
            index={i}
          />
        ))}
      </Cartouche>
    </section>

    <!-- ── Footer row ──────────────────────────────────────────── -->
    <section class="footer-row">
      <div class="footer-nav">
        <a href={`${base}/backend`} class="nav-link">← Backend</a>
        <a href={`${base}/infra`} class="nav-link">Infrastructure →</a>
      </div>
      <p class="footer-coord">Plate iii — Data Pipeline · RA +780° Dec +420°</p>
    </section>

  </main>
</BaseLayout>

<style>
  .domain-page {
    position: relative;
    z-index: 1;
    max-width: 1080px;
    margin: 0 auto;
    padding: 80px 32px 120px;
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  /* Breadcrumb */
  .breadcrumb {
    font-family: var(--font-mono);
    font-style: normal;
    font-size: 10px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--ink-dim);
    margin-bottom: 24px;
  }

  .breadcrumb a {
    color: var(--ink-dim);
    text-decoration: none;
  }

  .breadcrumb a:hover {
    color: var(--gold);
  }

  /* ── Hero row ── */
  .hero-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
    align-items: start;
  }

  @media (max-width: 768px) {
    .hero-row {
      grid-template-columns: 1fr;
    }
  }

  .domain-title {
    font-size: 56px;
    color: var(--tint-data);
    line-height: 1;
    margin-bottom: 8px;
  }

  .domain-subtitle {
    font-size: 18px;
    color: var(--ink-dim);
    margin-bottom: 20px;
    font-style: italic;
  }

  .domain-blurb {
    font-size: 17px;
    color: var(--ink);
    line-height: 1.55;
    margin-bottom: 28px;
  }

  .domain-meta {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .meta-item {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2px;
  }

  .meta-num {
    font-size: 32px;
    font-style: italic;
    color: var(--tint-data);
    line-height: 1;
  }

  .meta-label {
    font-family: var(--font-mono);
    font-style: normal;
    font-size: 9px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .meta-divider {
    width: 0.5px;
    height: 32px;
    background: var(--paper-border);
  }

  .minimap-container {
    width: 100%;
    height: 280px;
  }

  /* ── Visualisation row ── */
  .viz-header {
    margin-bottom: 28px;
  }

  .viz-title {
    font-size: 28px;
    color: var(--ink);
    margin-bottom: 10px;
  }

  .viz-caption {
    font-size: 15px;
    color: var(--ink-dim);
    line-height: 1.55;
    max-width: 560px;
  }

  .viz-canvas {
    width: 100%;
    margin-bottom: 20px;
  }

  .viz-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 28px;
    padding-top: 16px;
    border-top: 0.5px solid var(--line-faint);
  }

  .legend-item {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .legend-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .legend-text {
    font-family: var(--font-mono);
    font-style: normal;
    font-size: 10px;
    letter-spacing: 1px;
    color: var(--ink-dim);
  }

  /* ── Footer row ── */
  .footer-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 32px;
    border-top: 0.5px solid var(--line-faint);
  }

  .footer-nav {
    display: flex;
    gap: 32px;
  }

  .nav-link {
    font-size: 15px;
    color: var(--gold);
    text-decoration: none;
    font-style: italic;
  }

  .nav-link:hover {
    color: var(--gold-bright);
  }

  .footer-coord {
    font-family: var(--font-mono);
    font-style: normal;
    font-size: 9px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  /* ── Skill tree row ── */
  .skill-tree-header {
    margin-bottom: 28px;
  }

  .skill-tree-title {
    font-size: 28px;
    color: var(--ink);
    margin-bottom: 10px;
  }

  .skill-tree-caption {
    font-size: 15px;
    color: var(--ink-dim);
    line-height: 1.55;
    max-width: 560px;
  }

  .skill-tree-container {
    max-width: 520px;
    margin: 0 auto;
  }

  @media (max-width: 640px) {
    .domain-page {
      padding: 60px 20px 80px;
    }

    .footer-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
    }
  }
</style>
