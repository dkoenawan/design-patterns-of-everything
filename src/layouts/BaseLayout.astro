---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Solution Architect Portfolio',
  description = 'Design patterns, architecture experience, and real-world case studies from a career in software architecture.'
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="dark" />

    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
